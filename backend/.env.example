# LLM — any open-source model. Default: Ollama running locally.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Or an OpenAI-compatible open-source server (vLLM, llama.cpp server, LM Studio, LocalAI):
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_API_KEY=not-needed
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Local embedding model (fastembed / ONNX)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Web search: DuckDuckGo by default; set to a self-hosted SearXNG to use it instead
# (JSON output must be enabled in SearXNG settings).
# SEARXNG_URL=http://localhost:8080
WEB_SEARCH_RESULTS=10

DATA_DIR=./data
MEMORY_WINDOW=10
